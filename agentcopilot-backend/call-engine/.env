# Load local env by default (.env.local is loaded first and takes precedence)
# ONE Gnani key is used for both STT (Prisma) and TTS (Timbre).
GNANI_API_KEY=REPLACE_WITH_YOUR_GNANI_KEY
GNANI_API_BASE=https://api.vachana.ai

# Speech-to-Text: Prisma v3.0 (indic-auto detects any of the 10 languages)
GNANI_ASR_MODEL=prisma-v3.0
GNANI_ASR_LANGUAGE=indic-auto
GNANI_ASR_FORMAT=transliterate
GNANI_ASR_BATCH_FORMAT=codemix
GNANI_ASR_SAMPLE_RATE=16000

# Text-to-Speech: Timbre v3.0
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
GNANI_TTS_LANGUAGE=auto
GNANI_TTS_SPEED=1.0

GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_KEY
GEMINI_MODEL=gemini-2.0-flash
LLM_PROVIDER=gemini

CALL_ENGINE_PORT=3003
SAAS_BACKEND_PORT=4000
DATABASE_URL=file:./dev.db
JWT_SECRET=dev-secret-change-me-for-production
JWT_TTL_DAYS=7

DEMO_MODE=both
SAMPLES_DIR=./samples

